# Copy to .env. deploy/setup.sh does this for you and generates a real JWT_SECRET.
#
# NOTHING SECRET BELONGS IN THIS FILE. It is committed to a public repository.
# .env itself is gitignored and must stay that way: JWT_SECRET signs every session
# cookie, so anyone holding it can mint an admin session for this store.

NODE_ENV=production
PORT=4000

# Inside the API container this is overridden to reach the db service directly.
# The value here is for running the API on the host against the published port.
DATABASE_URL=postgres://aarunya:aarunya_local_pw@localhost:5433/aarunya

# Generated per server by deploy/setup.sh. Never commit a real one.
JWT_SECRET=change-me-to-a-long-random-string

# CORS is an explicit allow-list and these must match the browser's Origin exactly:
# scheme included, no trailing slash. A mismatch fails every admin action and every
# checkout with a CORS error rather than anything that reads like a login problem.
ADMIN_ORIGIN=https://admin.aarunyajewelsbyveena.in
STORE_ORIGIN=https://aarunyajewelsbyveena.in

# true everywhere the site is served over https. With this on, a browser will not
# store the session cookie over plain http, so sign-in silently fails on http.
COOKIE_SECURE=true

# Only used by the catalogue image pipeline, never by the running API.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Optional: override the database password. Changing this after the volume exists
# needs an ALTER USER as well — the variable alone will not move it.
POSTGRES_PASSWORD=
