NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://aarunya:aarunya_local_pw@localhost:5433/aarunya
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_ORIGIN=http://localhost:5174
STORE_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Image generation for the catalogue pipeline (catalogue/generate-images.mjs).
# Issued from Google AI Studio against your own Google account; billed to it.
# Leave empty and the pipeline prints its prompts instead of generating anything.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3-pro-image-preview
GEMINI_IMAGE_MODEL=
