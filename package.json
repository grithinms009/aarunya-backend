{
  "name": "aarunya-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aarunya jewellery store API — admin panel + storefront",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node test/rules.test.mjs",
    "db:snapshot": "node scripts/snapshot.mjs",
    "db:restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "pg": "8.13.1",
    "zod": "3.23.8"
  }
}
